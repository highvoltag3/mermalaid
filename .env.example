VITE_APP_NAME=Mermalaid
VITE_APP_VERSION=
VITE_GITHUB_REPO=
VITE_PUBLIC_SHARE_BASE_URL=
VITE_ENABLE_AI_FIXER=true
# Do NOT set VITE_OPENAI_API_KEY. Vite embeds VITE_* values in the public JS bundle.
# Users enter their key in Settings (stored in localStorage only).
# VITE_OPENAI_API_KEY=

# Live AI Agent bridge (local MCP WebSocket). See docs/AGENT_INTEGRATION.md.
VITE_ENABLE_AGENT_BRIDGE=true
VITE_AGENT_BRIDGE_HOST=127.0.0.1
VITE_AGENT_BRIDGE_PORT=7337

# ── Mermalaid for Slack (server-side; NOT exposed to the browser) ───────────
# Set the same values in your Vercel project (Settings → Environment Variables).
# See slack/README.md for the full setup guide.

# Bot User OAuth Token from your Slack app (Install App). Starts with xoxb-
SLACK_BOT_TOKEN=
# Signing Secret (Basic Information → App Credentials)
SLACK_SIGNING_SECRET=

# Optional — local dev only: path to a Chrome/Chromium binary for the renderer.
# Defaults to the standard macOS Google Chrome location if unset.
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Opt into Chromium --no-sandbox for local/CI containers that lack user namespaces.
# (Vercel/Lambda already use @sparticuz/chromium's args, which include --no-sandbox.)
# PUPPETEER_NO_SANDBOX=1

# Optional — fallback URL for the Mermaid library if the bundled copy isn't
# found at runtime. Only library JS is fetched, never diagram content. The
# default jsDelivr URL is integrity-checked, a custom URL skips that check.
# MERMAID_UMD_URL=https://cdn.jsdelivr.net/npm/mermaid@12.2.0/dist/mermaid.min.js

# Bind the Vite dev server to the LAN (default is localhost only).
# DEV_HOST=1

# ── Public preview links (/api/og, /api/preview) ───────────────────────────
# Set a random secret (e.g. `openssl rand -hex 32`) to sign preview links so the
# /api/og render endpoint only accepts links this server issued (blocks
# hotlinking / embedding it as a free render API). If unset, preview links work
# unsigned and /api/og will render any diagram passed to it.
# PREVIEW_LINK_SECRET=
# Comma-separated extra Origins allowed to call /api/sign (forks / previews).
# SIGN_ALLOWED_ORIGINS=https://my-fork.example
# Also allow Vite localhost Origins against /api/sign (local web testing).
# SIGN_ALLOW_DEV_ORIGINS=1

