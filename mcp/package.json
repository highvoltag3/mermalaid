{
  "name": "@mermalaid/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Local MCP server that bridges AI agents to a live Mermalaid diagram editor.",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Dario Novoa (highvoltag3)",
  "homepage": "https://github.com/highvoltag3/mermalaid/tree/main/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highvoltag3/mermalaid.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/highvoltag3/mermalaid/issues"
  },
  "keywords": [
    "mermaid",
    "mcp",
    "mermalaid",
    "diagram",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "mermalaid-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
