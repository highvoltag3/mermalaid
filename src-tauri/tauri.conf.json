{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mermalaid",
  "version": "1.9.5",
  "identifier": "com.mermalaid.desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQzc4NDk1NDJFRDExQUIKUldTckVlMUNsWVRIalNMeVVGdExHc2dRVUpYK2xSWS9vRXJUZHVkamY2VVZtWEVkZDFVNHMzaGgK",
      "endpoints": [
        "https://github.com/highvoltag3/mermalaid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mermalaid",
        "url": "/editor",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://mermalaid.com https://www.mermalaid.com https://api.openai.com https://api.github.com ws://127.0.0.1:* ws://localhost:*",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://mermalaid.com https://www.mermalaid.com https://api.openai.com https://api.github.com ws://127.0.0.1:* ws://localhost:* ws://localhost:5173 http://localhost:5173 http://127.0.0.1:5173",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "mmd"
        ],
        "name": "Mermaid diagram",
        "description": "Mermaid diagram source",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "md",
          "markdown",
          "txt"
        ],
        "name": "Text document",
        "description": "Markdown or text document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon_16x16.png",
      "icons/icon_16x16@2x.png",
      "icons/icon_32x32.png",
      "icons/icon_32x32@2x.png",
      "icons/icon_128x128.png",
      "icons/icon_128x128@2x.png",
      "icons/icon_256x256.png",
      "icons/icon_256x256@2x.png",
      "icons/icon_512x512.png",
      "icons/icon_512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.plist"
    }
  }
}
